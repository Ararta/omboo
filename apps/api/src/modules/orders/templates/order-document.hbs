<!doctype html>
<html lang="hy">
  <head>
    <meta charset="utf-8" />
    <style>
      @page {
        margin: 0;
      }
      body {
        font-family: "Times New Roman", Georgia, serif;
        color: #111;
        font-size: 14px;
        line-height: 1.55;
        margin: 0;
        padding: 0;
      }
      .company-name {
        font-size: 22px;
        font-weight: 700;
        color: #241619;
      }
      .rule {
        border-bottom: 2px dotted #241619;
        margin: 4px 0 10px;
      }
      .contact-line {
        font-size: 12px;
        color: #333;
      }
      .order-title {
        text-align: center;
        font-weight: 700;
        font-size: 18px;
        margin: 30px 0 6px;
        letter-spacing: 0.5px;
      }
      .meta-row {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        margin: 14px 0 22px;
      }
      .subject-line {
        text-align: center;
        font-weight: 700;
        font-size: 14px;
        margin: 0 0 18px;
      }
      .basis-line {
        margin-bottom: 16px;
      }
      .directive-heading {
        text-align: center;
        font-weight: 700;
        font-size: 15px;
        letter-spacing: 3px;
        margin: 0 0 18px;
      }
      ol.directives {
        padding-left: 22px;
        margin-bottom: 20px;
      }
      ol.directives > li {
        margin-bottom: 10px;
      }
      ul.detail-list {
        list-style: none;
        padding-left: 4px;
        margin-top: 8px;
      }
      .signature-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-top: 44px;
      }
      .signature-block {
        text-align: center;
        min-width: 160px;
      }
      .signature-image {
        height: 52px;
        margin-bottom: 4px;
        object-fit: contain;
      }
      .signature-image-placeholder {
        height: 52px;
      }
      .signature-name {
        border-top: 1px solid #000;
        padding-top: 4px;
      }
    </style>
  </head>
  <body>
    <div class="company-name">{{companyName}}</div>
    <div class="rule"></div>
    <div class="contact-line">{{address}}, {{phone}}, {{email}}</div>

    <div class="order-title">ՀՐԱՄԱՆ ԹԻՎ {{orderNumber}}</div>
    <div class="meta-row">
      <span>{{issueLocation}}</span>
      <span>{{issueDateHY}}</span>
    </div>

    <div class="subject-line">«{{companyName}}»-ի աշխատակից {{employeeName}}ին ամենամյա արձակուրդ տրամադրելու վերաբերյալ</div>

    <div class="basis-line">Հիմք ընդունելով ՀՀ աշխատանքային oրենսգրքով սահմանված դրույթները և աշխատակցի անհատական հայտ-դիմումը՝</div>

    <div class="directive-heading">ՀՐԱՄԱՅՈՒՄ ԵՄ</div>

    <ol class="directives">
      <li>
        «{{companyName}}»-ի աշխատակից {{employeeName}}ին {{workYearStartHY}} – {{workYearEndHY}} աշխատանքային տարվա համար
        տրամադրել ամենամյա արձակուրդ {{days}} աշխատանքային oր տևողությամբ.
        <ul class="detail-list">
          <li>➤ Ամենամյա արձակուրդի սկիզբ — {{startHY}}</li>
          <li>➤ Ամենամյա արձակուրդի ավարտ — {{endHY}}</li>
          <li>➤ Աշխատանքի ներկայանալու ամսաթիվ — {{returnDateHY}}</li>
        </ul>
      </li>
      <li>Հրամանը հասցնել «{{companyName}}»-ի աշխատակից {{employeeName}}ին.</li>
      <li>Հրամանի պատճենը հասցնել «{{companyName}}»-ի տնoրեն {{directorName}}ին.</li>
      <li>Հրամանի կատարման հսկողությունը հանձնարարել անձնակազմի գծով մասնագետ {{hrName}}ին.</li>
    </ol>

    <div class="signature-row">
      <div>«{{companyName}}» տնoրեն</div>
      <div class="signature-block">
        {{#if signed}}
          {{#if directorSignatureUrl}}
            <img class="signature-image" src="{{directorSignatureUrl}}" alt="ստորագրություն" />
          {{else}}
            <div class="signature-image-placeholder"></div>
          {{/if}}
        {{else}}
          <div class="signature-image-placeholder"></div>
        {{/if}}
        <div class="signature-name">{{directorName}}</div>
      </div>
    </div>
  </body>
</html>
