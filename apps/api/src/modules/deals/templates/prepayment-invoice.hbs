<!doctype html>
<html lang="hy">
  <head>
    <meta charset="utf-8" />
    <style>
      @page {
        margin: 0;
      }
      body {
        font-family: "Times New Roman", Georgia, serif;
        color: #111;
        font-size: 14px;
        line-height: 1.55;
        margin: 0;
        padding: 36px 40px;
      }
      .brand {
        font-size: 22px;
        font-weight: 700;
        color: #241619;
      }
      .rule {
        border-bottom: 2px dotted #241619;
        margin: 4px 0 20px;
      }
      .title {
        text-align: center;
        font-weight: 700;
        font-size: 18px;
        margin: 0 0 4px;
        letter-spacing: 0.5px;
      }
      .meta-row {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        margin: 6px 0 24px;
        color: #333;
      }
      .parties {
        display: flex;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 24px;
      }
      .party {
        flex: 1;
      }
      .party-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #666;
        margin-bottom: 4px;
      }
      .party-name {
        font-weight: 700;
        font-size: 15px;
      }
      table.items {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 24px;
      }
      table.items th,
      table.items td {
        border: 1px solid #ccc;
        padding: 8px 10px;
        text-align: left;
        font-size: 13px;
      }
      table.items th {
        background: #f5f2ee;
      }
      .total-row td {
        font-weight: 700;
        font-size: 15px;
      }
      .note {
        font-size: 12px;
        color: #555;
        margin-top: 20px;
      }
    </style>
  </head>
  <body>
    <div class="brand">Omboo</div>
    <div class="rule"></div>

    <div class="title">ԿԱՆԽԱՎՃԱՐԻ ՀԱՇԻՎ</div>
    <div class="meta-row">
      <span>Հաշիվ № {{invoiceNumber}}</span>
      <span>{{issueDateHY}}</span>
    </div>

    <div class="parties">
      <div class="party">
        <div class="party-label">Ստացող</div>
        <div class="party-name">{{customerCompanyName}}</div>
        <div>{{customerContactName}}</div>
        <div>{{customerEmail}}</div>
        <div>{{customerPhone}}</div>
      </div>
      <div class="party">
        <div class="party-label">Առաջարկող գործընկեր</div>
        <div class="party-name">{{partnerCompanyName}}</div>
      </div>
    </div>

    <table class="items">
      <thead>
        <tr>
          <th>Փաթեթ</th>
          <th>Ցիկլ</th>
          <th>Գումար (ՀՀ դրամ)</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>{{packageName}}</td>
          <td>{{billingCycleHY}}</td>
          <td>{{amountFormatted}} ֏</td>
        </tr>
        <tr class="total-row">
          <td colspan="2">Ընդամենը</td>
          <td>{{amountFormatted}} ֏</td>
        </tr>
      </tbody>
    </table>

    <div class="note">Սույն հաշիվը ծառայում է որպես կանխավճարի հիմք։ Վճարումից հետո կուղարկվի հարկային փաստաթուղթը։</div>
  </body>
</html>
