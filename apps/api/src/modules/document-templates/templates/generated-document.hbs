<!doctype html>
<html lang="hy">
  <head>
    <meta charset="utf-8" />
    <style>
      @page {
        margin: 0;
      }
      body {
        font-family: "Times New Roman", Georgia, serif;
        color: #111;
        font-size: 14px;
        line-height: 1.55;
        margin: 0;
        padding: 0;
      }
      .company-name {
        font-size: 22px;
        font-weight: 700;
        color: #241619;
      }
      .rule {
        border-bottom: 2px dotted #241619;
        margin: 4px 0 10px;
      }
      .doc-title {
        text-align: center;
        font-weight: 700;
        font-size: 18px;
        margin: 30px 0 24px;
        letter-spacing: 0.5px;
      }
      .content {
        margin-bottom: 40px;
      }
      .content p {
        margin: 0 0 10px;
      }
      .signature-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-top: 44px;
        gap: 24px;
      }
      .signature-block {
        text-align: center;
        flex: 1;
      }
      .signature-mark {
        font-size: 13px;
        color: #241619;
        border-top: 1px solid #000;
        padding-top: 4px;
      }
      .signature-name {
        font-weight: 700;
      }
      .signature-timestamp {
        font-size: 11.5px;
        color: #555;
        margin-top: 2px;
      }
    </style>
  </head>
  <body>
    <div class="company-name">{{companyName}}</div>
    <div class="rule"></div>

    <div class="doc-title">{{title}}</div>

    <div class="content">{{{contentHtml}}}</div>

    <div class="signature-row">
      <div class="signature-block">
        <div class="signature-mark">
          <div class="signature-name">{{employeeName}}</div>
          <div>✓ Ստորագրված է (էլեկտրոնային հաստատում)</div>
          <div class="signature-timestamp">{{employeeSignedAtHY}}</div>
        </div>
      </div>
      <div class="signature-block">
        <div class="signature-mark">
          <div class="signature-name">{{directorName}}</div>
          <div>✓ Ստորագրված է (էլեկտրոնային հաստատում)</div>
          <div class="signature-timestamp">{{directorSignedAtHY}}</div>
        </div>
      </div>
    </div>
  </body>
</html>
