{
  "expo": {
    "name": "Omboo",
    "slug": "omboo",
    "scheme": "omboo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "am.omboo.mobile"
    },
    "android": {
      "package": "am.omboo.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
