# Expo reads env vars prefixed EXPO_PUBLIC_ from this file (apps/mobile/.env), not the
# monorepo root .env. Copy this to apps/mobile/.env.
#
# For the iOS Simulator / Android Emulator, "localhost" reaching your machine's API works
# out of the box on iOS; on Android emulators use 10.0.2.2 instead of localhost. For a
# physical device (Expo Go), use your machine's LAN IP so the phone can reach it.
EXPO_PUBLIC_API_URL="http://localhost:4000"
