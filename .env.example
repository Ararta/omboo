# Copy to .env and .env in apps/api, apps/web as needed. Values below match docker-compose.yml defaults.

# --- Database (packages/database, apps/api) ---
# DATABASE_URL: superuser, used by prisma migrate/generate and one-off scripts (bypasses RLS).
DATABASE_URL="postgresql://omboo:omboo_dev_password@localhost:5432/omboo?schema=public"
# APP_DATABASE_URL: unprivileged role the running API actually connects as, so Postgres RLS
# (Layer 2 of the multi-tenant isolation model) applies to every query the app issues. Created by
# the enable_rls migration (packages/database/prisma/migrations/*_enable_rls) — run migrations
# with DATABASE_URL first, then this role exists and the app can use it.
APP_DATABASE_URL="postgresql://omboo_app:omboo_app_dev_password@localhost:5432/omboo?schema=public"

# --- Auth (apps/api) ---
JWT_ACCESS_SECRET="change-me-access-secret-dev-only"
JWT_REFRESH_SECRET="change-me-refresh-secret-dev-only"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# --- S3-compatible storage (apps/api) — MinIO locally ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="omboo"
S3_SECRET_ACCESS_KEY="omboo_dev_password"
S3_BUCKET="omboo-signatures"
S3_FORCE_PATH_STYLE="true"

# --- Email (apps/api) ---
RESEND_API_KEY="re_your_api_key_here"
RESEND_FROM_EMAIL="Omboo <no-reply@omboo.am>"
# When unset/not "true", the API logs emails instead of sending (safe local default).
EMAIL_SEND_ENABLED="false"

# --- apps/api ---
API_PORT="4000"
WEB_ORIGIN="http://localhost:3000"

# --- apps/web ---
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- apps/mobile ---
EXPO_PUBLIC_API_URL="http://localhost:4000"
