# Documentation only — do not use these values for a real deployment. Run ./deploy/generate-env.sh
# on the server instead; it writes a real .env.production (gitignored) with random secrets.

POSTGRES_PASSWORD=REPLACE_ME
APP_DB_PASSWORD=REPLACE_ME

DATABASE_URL=postgresql://omboo:REPLACE_ME@db:5432/omboo?schema=public
APP_DATABASE_URL=postgresql://omboo_app:REPLACE_ME@db:5432/omboo?schema=public

JWT_ACCESS_SECRET=REPLACE_ME
JWT_REFRESH_SECRET=REPLACE_ME
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME
S3_BUCKET=omboo-signatures
S3_FORCE_PATH_STYLE=true

RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Omboo <no-reply@omboo.am>
EMAIL_SEND_ENABLED=false

API_PORT=4000
WEB_ORIGIN=https://app.omboo.am
NEXT_PUBLIC_API_URL=https://api.omboo.am
