// Omboo — multi-tenant schema. Every tenant table carries organizationId directly (not
// derived through joins) so the Prisma Client Extension in packages/database/src/tenant-scope.ts
// can apply one uniform filter everywhere, and so Postgres RLS policies (see
// prisma/migrations/*_enable_rls/migration.sql) can reference a single flat column on every table.
// See reference/Omboo_texnikakan_handznararagir.docx and reference/mrk_prototype_1.jsx for the
// underlying business rules.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  EMPLOYEE
  DIRECTOR
  HR
}

enum RequestType {
  VACATION
  UNPAID
  SICK
  DAYOFF
}

// SUBMITTED -> APPROVED -> ORDER_CREATED
//           -> REJECTED (director rejected, mandatory note)
//           -> CANCELLED (employee withdrew before a decision)
enum RequestStatus {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  ORDER_CREATED
}

enum RecallStatus {
  PENDING_EMPLOYEE
  ACCEPTED
  DECLINED
  FINALIZED
}

// Two independent order-number sequences (հրց-<year>-<100|200+n>), matching the prototype's
// convention: PRIMARY for ordinary leave orders, RECALL for early-return orders.
enum OrderSeries {
  PRIMARY
  RECALL
}

// One row per registered company. `slug` drives subdomain-based tenant resolution
// (<slug>.omboo.am) in apps/web/middleware.ts.
model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique

  users               User[]
  employees           Employee[]
  documents           EmployeeDocument[]
  attendanceLogs      AttendanceLog[]
  requests            Request[]
  requestHistory      RequestHistory[]
  recalls             Recall[]
  orgSettings         OrgSettings?
  orderSequences      OrderSequence[]
  notifications       Notification[]
  balanceAdjustments  BalanceAdjustmentLog[]
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  documentTemplates   DocumentTemplate[]
  generatedDocuments  GeneratedDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  role         Role
  // Only set for self-registered backend (HR) accounts that have no linked Employee row.
  name         String?

  // Self-registered HR accounts start pending until a DIRECTOR approves them; seeded/
  // employees.service.ts-created accounts default to false (already trusted). Organization
  // founders (register-organization) are also false — nobody exists yet to approve them.
  pendingApproval Boolean @default(false)

  // TOTP two-factor, required for HR/DIRECTOR ("backend") logins once enabled. The secret is
  // written as soon as setup starts but totpEnabled only flips true after a confirmed code.
  totpSecret  String?
  totpEnabled Boolean @default(false)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  employee      Employee?      @relation(fields: [employeeId], references: [id])
  employeeId    String?        @unique
  refreshTokens RefreshToken[]
  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([organizationId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([organizationId])
  @@map("refresh_tokens")
}

model Employee {
  id       String @id @default(cuid())
  name     String
  position String
  // Was globally @unique pre-multi-tenant; now unique per organization (see @@unique below).
  email    String

  hireDate DateTime @db.Date

  // հոդված 159, 160, 161 — three independent, HR-editable leave-day fields.
  minimumDays    Int @default(0)
  extendedDays   Int @default(0)
  additionalDays Int @default(0)

  // Derived (minimumDays + extendedDays + additionalDays), recomputed server-side on every write —
  // persisted for query/display simplicity, never trusted as client input.
  annualTotal Int @default(0)
  balance     Int @default(0)

  // Separate internal "day off" pool — independent of statutory vacation balance.
  dayOffBalance Int @default(0)

  // հոդված 164.10 — 2.5-year silent-employee reminder cadence bookkeeping.
  lastVacationRequestDate DateTime? @db.Date
  lastReminderFired       Int?

  // HR manual override: "the >=10-business-day chunk requirement is already satisfied" (հոդված 163).
  tenDayChunkConfirmed Boolean @default(false)

  // հոդված 164.4, 164.6, 164.8-9 — informational priority-scheduling flags (not enforced as hard blocks).
  priorityUnder18          Boolean @default(false)
  priorityParentOrPregnant Boolean @default(false)
  priorityTeacher          Boolean @default(false)
  priorityCaregiver        Boolean @default(false)
  priorityViolenceVictim   Boolean @default(false)

  // Org chart — nullable self-relation. A cycle (A manages B manages A) is prevented at the
  // service layer, not the DB, since Postgres has no native "no cycles" constraint.
  managerId String?
  manager   Employee?  @relation("EmployeeManager", fields: [managerId], references: [id])
  reports   Employee[] @relation("EmployeeManager")

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  user               User?
  requests           Request[]
  balanceAdjustments BalanceAdjustmentLog[]
  attendanceLogs     AttendanceLog[]
  documents          EmployeeDocument[]
  generatedDocuments GeneratedDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("employees")
}

// CONTRACT/AGREEMENT/ORDER/STATEMENT/CLAIM double as the five DocumentTemplate categories
// (պայմանագրեր/համաձայնագրեր/հրամաններ/դիմումներ/հայտեր) — CERTIFICATE/ID_DOCUMENT/OTHER exist
// only for the plain manual-upload flow (EmployeeDocument), never as a template category
// (enforced by createTemplateSchema in packages/shared, not the DB).
enum DocumentCategory {
  CONTRACT
  AGREEMENT
  ORDER
  STATEMENT
  CLAIM
  CERTIFICATE
  ID_DOCUMENT
  OTHER
}

// HR document library — one row per uploaded file, always scoped to one employee (company-wide
// documents aren't in scope yet). The file itself lives in S3/MinIO under a
// documents/<organizationId>/<employeeId>/... key; this row is metadata only.
model EmployeeDocument {
  id         String @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  title    String
  category DocumentCategory
  fileKey  String // S3 object key, not base64
  fileName String
  mimeType String
  fileSize Int

  uploadedByUserId String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  // Set when this row is the final signed PDF of a GeneratedDocument (see that model) rather
  // than a plain HR upload — same library, same download/list UI, no special-casing needed there.
  generatedDocument GeneratedDocument?

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([organizationId])
  @@map("employee_documents")
}

// GPS-based clock-in/out. Location is captured only at the two discrete tap moments the
// employee initiates — never polled or tracked in the background — so there is no location
// data outside working hours by construction. Raw coordinates are readable only by the owning
// employee and HR (see attendance.controller.ts guards); never surfaced to DIRECTOR or in any
// exported/emailed document.
model AttendanceLog {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  checkInAt             DateTime
  // Null only for entries HR created/corrected by hand (no real device GPS reading).
  checkInLat            Float?
  checkInLng            Float?
  checkInWithinGeofence Boolean?

  checkOutAt             DateTime?
  checkOutLat            Float?
  checkOutLng            Float?
  checkOutWithinGeofence Boolean?

  // Set when HR manually creates or corrects an entry (e.g. a missed clock-out).
  editedByUserId String?
  editedAt       DateTime?
  note           String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, checkInAt])
  @@index([organizationId])
  @@map("attendance_logs")
}

model Request {
  id         String @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  type   RequestType
  start  DateTime      @db.Date
  end    DateTime      @db.Date
  days   Int
  reason String?
  status RequestStatus @default(SUBMITTED)

  orderNumber String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  history RequestHistory[]
  recall  Recall?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
  @@index([status])
  @@index([organizationId])
  @@map("requests")
}

model RequestHistory {
  id        String  @id @default(cuid())
  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  // Exact Armenian step text, mirrors the prototype's Timeline entries verbatim.
  step             String
  actorUserId      String? // null for system/cron-originated entries
  actorDisplayName String // snapshotted so it survives a later user rename/deletion
  note             String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([organizationId])
  @@map("request_history")
}

model Recall {
  id        String  @id @default(cuid())
  requestId String  @unique
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  requestedEnd DateTime     @db.Date
  reason       String
  status       RecallStatus @default(PENDING_EMPLOYEE)
  requestedAt  DateTime     @default(now())
  orderNumber  String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("recalls")
}

// One row per organization (was a singleton `id=1` row pre-multi-tenant) — company/director/HR
// contact info applied to every generated order. organizationId is now the primary key (1:1
// with Organization) now that the backfill migration has populated it on every row.
model OrgSettings {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  companyName          String
  address              String
  phone                String
  email                String
  directorName         String
  directorSignatureKey String? // S3 object key, not base64
  hrName               String
  hrEmail              String

  // Attendance geofence — check-in/out is validated against this point. Null until HR sets it
  // (via the "Օգտագործել կազմակերպության հասցեն" flow or manual entry), in which case the
  // mobile app allows check-in from anywhere and just flags it as outside-geofence.
  officeLat            Float?
  officeLng            Float?
  geofenceRadiusMeters Int    @default(150)

  updatedAt DateTime @updatedAt

  @@map("org_settings")
}

// Atomic per-organization/year/series order-number counter — replaces the prototype's
// non-concurrency-safe in-memory `requests.filter(...).length` count.
model OrderSequence {
  id        String      @id @default(cuid())
  year      Int
  series    OrderSeries
  lastValue Int         @default(0)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, year, series])
  @@index([organizationId])
  @@map("order_sequences")
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  text             String
  relatedRequestId String?
  read             Boolean @default(false)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([organizationId])
  @@map("notifications")
}

model BalanceAdjustmentLog {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  field           String // "balance" | "dayOffBalance"
  previousValue   Int
  nextValue       Int
  changedByUserId String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([organizationId])
  @@map("balance_adjustment_log")
}

model AuditLog {
  id          String @id @default(cuid())
  actorUserId String
  action      String // e.g. "employee.update", "org-settings.update"
  entityType  String
  entityId    String
  metadata    Json?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([organizationId])
  @@map("audit_log")
}

// HR authors these once per document type their organization actually uses (a standard
// employment contract, an NDA, a generic order template, etc.) — free-form rich text
// (contentHtml, authored in the web app's TipTap editor) with {{placeholder}} tokens. Known
// tokens (employeeName, companyName, today, ...) are auto-filled at generation time from
// Employee/OrgSettings data; any other {{token}} found in the content becomes a field HR fills
// in by hand each time they generate a document from this template (see
// DocumentTemplatesService.findCustomFields).
model DocumentTemplate {
  id          String           @id @default(cuid())
  name        String
  category    DocumentCategory
  contentHtml String

  createdByUserId String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  generatedDocuments GeneratedDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, category])
  @@map("document_templates")
}

// PENDING_EMPLOYEE_SIGNATURE -> PENDING_DIRECTOR_SIGNATURE -> COMPLETED
//                            -> CANCELLED (HR withdrew it before either signature)
enum GeneratedDocumentStatus {
  PENDING_EMPLOYEE_SIGNATURE
  PENDING_DIRECTOR_SIGNATURE
  COMPLETED
  CANCELLED
}

// One instance of a DocumentTemplate filled in for one Employee. contentHtml is a snapshot
// taken at generation time (placeholders already resolved) — editing the source template later
// never changes documents already generated from it. "Signing" is a click-to-confirm action
// (employeeSignedAt/By, then directorSignedAt/By), not a drawn or uploaded signature image;
// once both are present the final PDF is rendered and filed into EmployeeDocument automatically.
model GeneratedDocument {
  id         String   @id @default(cuid())
  templateId String
  template   DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  title       String
  category    DocumentCategory
  contentHtml String
  status      GeneratedDocumentStatus @default(PENDING_EMPLOYEE_SIGNATURE)

  createdByUserId String

  employeeSignedAt       DateTime?
  employeeSignedByUserId String?
  directorSignedAt       DateTime?
  directorSignedByUserId String?

  finalDocumentId String?           @unique
  finalDocument   EmployeeDocument? @relation(fields: [finalDocumentId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([employeeId])
  @@map("generated_documents")
}
